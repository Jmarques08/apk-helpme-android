{
  "appId": "app.helpme.demo",
  "appName": "HelpMe!",
  "webDir": "www",
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "launchFadeOutDuration": 250,
      "backgroundColor": "#FFFFFF",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    }
  },
  "android": {
    "adjustMarginsForEdgeToEdge": "force"
  }
}
